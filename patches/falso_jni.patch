-    getFieldValueById(jobject, FIELD_TYPE_OBJECT, FieldsObject, fieldsObject, fieldsObject_size, id, (jobject)0x42424242);
+    // ID 0 is JNI NULL, never a valid object field. Both GetObjectField and
+    // GetStaticObjectField use this path; missing fields must not become
+    // a string or the activity sentinel masquerading as a Java array.
