+
+static inline uint16_t zombie_texture_rgba8888_pixel_to_rgb565(const uint8_t *src) {
+    return (uint16_t)(((uint16_t)(src[0] & 0xF8u) << 8) |
+                      ((uint16_t)(src[1] & 0xFCu) << 3) |
+                      ((uint16_t)src[2] >> 3));
+}
+
+/* Convert the software renderer's GL_RGBA/U8 framebuffer directly into the
+ * RGB565 allocation sampled by GXM. Destination/source strides are bytes.
+ * Alpha is intentionally discarded: this texture is the final opaque software
+ * framebuffer composited by OpenGLES::UnLock. */
+static inline void zombie_texture_rgba8888_to_rgb565(void *dst, const void *src,
+        unsigned width, unsigned height, size_t dst_stride, size_t src_stride) {
+    uint8_t *drow = (uint8_t *)dst;
+    const uint8_t *srow = (const uint8_t *)src;
+    for (unsigned y = 0; y < height; ++y) {
+        uint16_t *d = (uint16_t *)drow;
+        const uint8_t *s = srow;
+        unsigned x = 0;
+#if defined(__ARM_NEON)
+        for (; x + 8 <= width; x += 8) {
+            uint8x8x4_t rgba = vld4_u8(s + (size_t)x * 4);
+            uint16x8_t r = vmovl_u8(rgba.val[0]);
+            uint16x8_t g = vmovl_u8(rgba.val[1]);
+            uint16x8_t b = vmovl_u8(rgba.val[2]);
+            r = vshlq_n_u16(vshrq_n_u16(r, 3), 11);
+            g = vshlq_n_u16(vshrq_n_u16(g, 2), 5);
+            b = vshrq_n_u16(b, 3);
+            vst1q_u16(d + x, vorrq_u16(r, vorrq_u16(g, b)));
+        }
+#endif
+        for (; x < width; ++x)
+            d[x] = zombie_texture_rgba8888_pixel_to_rgb565(s + (size_t)x * 4);
+        drow += dst_stride;
+        srow += src_stride;
+    }
+}
