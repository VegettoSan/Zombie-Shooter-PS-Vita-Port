-static int persist_type(int t) {
-    int mode = setting_log_mode;
-    if (mode <= 0) return 0;
-    if (t == LT_FATAL || t == LT_ERROR) return mode >= 1;
-    if (t == LT_PERF) return mode >= 2;
-#ifdef DEBUG_SOLOADER
-    return mode >= 3;
-#else
-    return 0;
-#endif
-}
