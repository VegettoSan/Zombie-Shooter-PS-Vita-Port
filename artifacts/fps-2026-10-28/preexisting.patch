+name: Zombie Shooter 3.6.1 Vita VPK
+
+on:
+  push:
+    branches:
+      - master
+  workflow_dispatch:
+    inputs:
+      notes:
+        description: Optional physical Vita test note
+        required: false
+        default: ''
+        type: string
+
+permissions:
+  contents: write
+
+concurrency:
+  group: zombie-shooter-361-vita-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  build-vpk:
+    name: 3.6.1 ARMv7 - Debug + Release
+    runs-on: ubuntu-22.04
+    env:
+      VITASDK: /usr/local/vitasdk
+      ZOMBIE_GAME_VERSION: 3.6.1
+      ZOMBIE_GAME_VERSION_CODE: '1161'
+      ZOMBIE_SO_SIZE: '9908972'
+      ZOMBIE_SO_SHA1: f7c7bbfc41f7ed8b76c8c5b1af3e9b0dfdf188c0
+      ZOMBIE_SO_SHA256: cb461ac47de79536824e8f7b64fa82293b796bcc159675b4f5ad6304e60bdca1
+    defaults:
+      run:
+        shell: bash
+
+    steps:
+      - name: Checkout source and pinned submodules
+        uses: actions/checkout@v4
+        with:
+          submodules: recursive
+          fetch-depth: 0
+
+      - name: Install exact SoftFP VitaSDK baseline
+        run: bash scripts/install_baseline_sdk.sh
+
+      - name: Verify SoftFP toolchain
+        run: |
+          set -euo pipefail
+          export PATH="$VITASDK/bin:$PATH"
+          "$VITASDK/bin/arm-vita-eabi-gcc" -Q --help=target | tee /tmp/gcc-target.txt
+          grep -E -- '-mfloat-abi=[[:space:]]*softfp|softfp' /tmp/gcc-target.txt
+
+      - name: Prepare verified 3.6.1 recovery profile
+        run: |
+          set -euo pipefail
+          python3 scripts/prepare_game_361_incremental.py
+          grep -F 'NewStringUTF(&jni, "3.6.1")' source/java_base.inc
+          grep -F 'return 1161;' source/java_base.inc
+
+      - name: Bridge regressions for 3.6.1 recovery
+        run: |
+          set -euo pipefail
+          bash tests/run_jni_field_regression.sh
+          bash tests/run_gamepad_regression.sh
+          bash tests/run_settings_regression.sh
+          tests/run_logger_regression.sh
+          bash tests/run_asset_index_regression.sh
+
+      - name: Build Debug VPK
+        run: |
+          set -euo pipefail
+          export PATH="$VITASDK/bin:$PATH"
+          rm -rf build-session-debug
+          cmake -S . -B build-session-debug \
+            -DCMAKE_BUILD_TYPE=Debug \
+            -DZOMBIE_BUILD_ID="361-${GITHUB_SHA}"
+          cmake --build build-session-debug -j"$(nproc)" 2>&1 | tee build-debug.log
+          test -s build-session-debug/zombie_shooter.vpk
+          test -s build-session-debug/so_loader
+          unzip -t build-session-debug/zombie_shooter.vpk
+
+      - name: Build Release VPK
+        run: |
+          set -euo pipefail
+          export PATH="$VITASDK/bin:$PATH"
+          rm -rf build-session-release
+          cmake -S . -B build-session-release \
+            -DCMAKE_BUILD_TYPE=Release \
+            -DZOMBIE_BUILD_ID="361-${GITHUB_SHA}"
+          cmake --build build-session-release -j"$(nproc)" 2>&1 | tee build-release.log
+          test -s build-session-release/zombie_shooter.vpk
+          test -s build-session-release/so_loader
+          unzip -t build-session-release/zombie_shooter.vpk
+          python3 scripts/check_release_flags.py build-session-release
+
+      - name: Package VPKs and symbol files
+        id: meta
+        run: |
+          set -euo pipefail
+          mkdir -p dist
+          short_sha="${GITHUB_SHA:0:7}"
+          tag="vita-361-test-${GITHUB_RUN_NUMBER}-${short_sha}"
+          echo "tag=$tag" >> "$GITHUB_OUTPUT"
+
+          cp build-session-debug/zombie_shooter.vpk dist/Zombie-Shooter-3.6.1-Vita-Debug.vpk
+          cp build-session-release/zombie_shooter.vpk dist/Zombie-Shooter-3.6.1-Vita-Release.vpk
+          cp build-session-debug/so_loader dist/Zombie-Shooter-3.6.1-Vita-Debug.elf
+          cp build-session-release/so_loader dist/Zombie-Shooter-3.6.1-Vita-Release.elf
+          cp scripts/vitasdk-version.txt dist/
+          git submodule status > dist/submodules.txt
+
+          cat > dist/GAME-DATA-REQUIRED.txt <<EOF
+          Zombie Shooter Free ${ZOMBIE_GAME_VERSION}
+          versionCode=${ZOMBIE_GAME_VERSION_CODE}
+          ABI=armeabi-v7a
+          Vita path=ux0:data/zombieshooter/
+          libzombie_shooter.so size=${ZOMBIE_SO_SIZE}
+          libzombie_shooter.so SHA1=${ZOMBIE_SO_SHA1}
+          libzombie_shooter.so SHA256=${ZOMBIE_SO_SHA256}
+
+          The original Android library and assets are NOT included in this artifact.
+          Use scripts/extract_game_361.py on your legally obtained 3.6.1 XAPK,
+          then copy libzombie_shooter.so and the complete assets/ directory to
+          ux0:data/zombieshooter/ before launching the VPK.
+          EOF
+
+          cat > dist/build-info.txt <<EOF
+          Commit: $GITHUB_SHA
+          Android target: Zombie Shooter 3.6.1 build 1161 armeabi-v7a
+          SDK: /usr/local/vitasdk, SoftFP
+          Recovery profile: verified 3.6.1 M4A/AAC music hooks, 864 render scale, adaptive software-frame reuse, native gamepad bridge, incremental direct Registry save files
+          Safety policy: old 3.2.3-only startup/raster/light/palette hooks remain disabled unless individually re-derived for 3.6.1
+          Runtime verification: requires physical PS Vita
+          EOF
+
+          cp build-debug.log dist/
+          cp build-release.log dist/
+          sha256sum dist/*.vpk dist/*.elf > dist/SHA256SUMS.txt
+
+      - name: Upload VPK artifact
+        uses: actions/upload-artifact@v4
+        with:
+          name: Zombie-Shooter-3.6.1-Vita-${{ steps.meta.outputs.tag }}
+          path: dist/
+          if-no-files-found: error
+          retention-days: 14
+
+      - name: Publish physical-test pre-release
+        if: success()
+        uses: softprops/action-gh-release@v2
+        with:
+          tag_name: ${{ steps.meta.outputs.tag }}
+          target_commitish: ${{ github.sha }}
+          name: Zombie Shooter 3.6.1 Vita Test ${{ github.run_number }}
+          prerelease: true
+          make_latest: false
+          body: |
+            Zombie Shooter 3.6.1 build 1161 armeabi-v7a recovery test for physical PS Vita.
+
+            This build re-enables only functionality re-derived and guarded against the 3.6.1 ARMv7 binary: the working M4A/AAC music replacement, the 864-wide software render scale, and adaptive software-frame reuse. Old 3.2.3-only startup/raster/light/palette hooks remain disabled.
+
+            The Vita control profile maps L/R to the game's verified next/previous-weapon HAT actions while rear-left/rear-right remain LT/RT (medikit/grenade). Registry saves are persisted incrementally under `ux0:data/zombieshooter/save/`: one changed key writes one `.dat`, with no per-file device-wide `ux0:` sync or whole-Registry rewrite on apply.
+
+            The VPK does not include proprietary Android game files. Prepare the data with `scripts/extract_game_361.py` and copy it to `ux0:data/zombieshooter/`.
+
+            Use Release for FPS comparison. If music, controls, saves or stability still fail, reproduce once with Debug and attach the generated logs.
+
+            Commit: `${{ github.sha }}`
+            Physical Vita verification remains separate from build verification.
+          files: dist/*
